# Конфигурация устройств GoIP
# Для каждого устройства создайте блок с именем GoipXX, где XX - произвольный идентификатор.
# Поля host, user, password обязательны.

Goip32:
  host: 192.168.1.100:80   # IP-адрес и порт веб-интерфейса GoIP
  user: admin              # Логин для входа в веб-интерфейс
  password: password       # Пароль для входа в веб-интерфейс

Goip33:
  host: 192.168.1.101:80
  user: admin
  password: password

# Настройки отправки бэкапов в Telegram
Telegram:
  TOKEN: "ВАШ_ТОКЕН_БОТА"   # Токен бота, полученный у @BotFather
  CHAT_ID: "ВАШ_CHAT_ID"    # ID чата, куда будут отправляться бэкапы